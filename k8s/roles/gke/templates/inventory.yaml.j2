loadgenerators:
  hosts:
{% for address in simulator_client_public_addresses %}
    {{ address }}:
      ssh_user: {{ client_machine_username }}
      ssh_options: -i {{ ssh_private_key_path }} -o StrictHostKeyChecking=no -o ConnectTimeout=60
{% endfor %}
  vars:
    ansible_user: {{ client_machine_username }}
    ansible_ssh_private_key_file: {{ ssh_private_key_path }}
